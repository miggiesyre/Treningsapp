# Names only – real values go in .env.local (never committed) and in Vercel → Settings → Environment Variables.

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
# "Publishable key" (sb_publishable_…) – or the legacy "anon" key. Safe in the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# "Secret key" (sb_secret_…) – or the legacy "service_role" key. Server only. Mark as Sensitive on Vercel.
SUPABASE_SECRET_KEY=

# Strava → strava.com/settings/api. Callback domain: the app's domain (trening.miggie.no).
STRAVA_CLIENT_ID=
# Server only. Mark as Sensitive on Vercel.
STRAVA_CLIENT_SECRET=
# Optional: 32 random bytes, base64. Encrypts integration tokens. Derived from SUPABASE_SECRET_KEY when unset.
TOKEN_ENC_KEY=
